#> marker_motion:load
#
# ロード時に読まれるコマンド
#
# @within tag/function minecraft:load


# ディメンション生成のチェック
  data modify storage neac: DimensionGenerated set value 0b
  execute store success storage neac: DimensionGenerated byte 1 in marker_motion: run help help .
  execute unless data storage neac: {DimensionGenerated:1b} run tellraw @a {"text":"==============================\nディメンションの生成を確認できませんでした。\n生成にはワールドの再読み込みが必要です。\n==============================","color":"#ff0000"}

# 追加ディメンションに対してforceloadと固定UUIDのmarkerの設置を行う
  execute if data storage neac: {DimensionGenerated:1b} in marker_motion: run forceload add -1 -1 1 1
  execute if data storage neac: {DimensionGenerated:1b} in marker_motion: run summon marker 0.0 0.0 0.0 {UUID:[I;5636,369366532,369360896,5636]}



# スコアオブジェクト作成
  scoreboard objectives add neac_value dummy

  scoreboard objectives add 1000 dummy
  scoreboard players set #global 1000 1000
